# Preferred deployment mode: keep the Gemini key only on the Vercel server.
# Create a free key in Google AI Studio and add it as a Vercel environment variable.
GEMINI_API_KEY=

# Sample/test mode only. When true (default), a user may paste their own key in the UI.
# The key is sent in the x-gemini-api-key header for that request and is not stored server-side.
# Set false when GEMINI_API_KEY is configured for a shared deployment.
ALLOW_USER_GEMINI_KEY=true
